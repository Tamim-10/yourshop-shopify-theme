{% liquid
  assign block_settings = block.settings
%}
<div class="cp-hiw__panel{% if block_settings.reverse_layout %} cp-hiw__panel--reverse{% endif %}" {{ block.shopify_attributes }}>
  <div class="cp-hiw__panel-media">
    {%- if block_settings.image != blank -%}
      {{ block_settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400' }}
    {%- endif -%}
  </div>
  <div class="cp-hiw__panel-content">
    <h4>{{ block_settings.heading }}</h4>
    <div class="cp-hiw__panel-text">{{ block_settings.text }}</div>
    <div class="cp-hiw__panel-icons">
      {% content_for 'blocks' %}
    </div>
    {%- if block_settings.show_store_badges -%}
      <div class="cp-hiw__store-badges">
        {%- if block_settings.app_store_badge != blank -%}
          {{ block_settings.app_store_badge | image_url: width: 240 | image_tag: loading: 'lazy', width: 120 }}
        {%- endif -%}
        {%- if block_settings.play_store_badge != blank -%}
          {{ block_settings.play_store_badge | image_url: width: 240 | image_tag: loading: 'lazy', width: 120 }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Feature panel",
  "tag": null,
  "blocks": [
    { "type": "_cp-panel-icon" }
  ],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Connection made for kids" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "reverse_layout", "label": "Image on right", "default": false },
    { "type": "checkbox", "id": "show_store_badges", "label": "Show app store badges", "default": false },
    { "type": "image_picker", "id": "app_store_badge", "label": "App Store badge" },
    { "type": "image_picker", "id": "play_store_badge", "label": "Google Play badge" }
  ],
  "presets": [
    { "name": "Feature panel" }
  ]
}
{% endschema %}
