{% liquid
  assign block_settings = block.settings
%}
<div class="cp-hiw__panel{% if block_settings.reverse_layout %} cp-hiw__panel--reverse{% endif %}" {{ block.shopify_attributes }}>
  <div class="cp-hiw__panel-media">
    {%- render 'cp-image-with-fallback',
      image: block_settings.image,
      fallback: block_settings.fallback_image,
      width: 1400
    -%}
  </div>
  <div class="cp-hiw__panel-content">
    <h4>{{ block_settings.heading }}</h4>
    <div class="cp-hiw__panel-text">{{ block_settings.text }}</div>
    <div class="cp-hiw__panel-icons">
      {% content_for 'blocks' %}
    </div>
    {%- if block_settings.show_store_badges -%}
      <div class="cp-hiw__store-badges">
        {%- render 'cp-image-with-fallback',
          image: block_settings.app_store_badge,
          fallback: block_settings.fallback_app_store_badge,
          width: 240,
          render_width: 120
        -%}
        {%- render 'cp-image-with-fallback',
          image: block_settings.play_store_badge,
          fallback: block_settings.fallback_play_store_badge,
          width: 240,
          render_width: 120
        -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Feature panel",
  "tag": null,
  "blocks": [
    { "type": "_cp-panel-icon" }
  ],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Connection made for kids" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "reverse_layout", "label": "Image on right", "default": false },
    { "type": "checkbox", "id": "show_store_badges", "label": "Show app store badges", "default": false },
    { "type": "image_picker", "id": "app_store_badge", "label": "App Store badge" },
    { "type": "image_picker", "id": "play_store_badge", "label": "Google Play badge" },
    { "type": "text", "id": "fallback_image", "label": "Fallback image asset filename", "visible_if": "{{ false }}" },
    { "type": "text", "id": "fallback_app_store_badge", "label": "Fallback App Store badge filename", "visible_if": "{{ false }}" },
    { "type": "text", "id": "fallback_play_store_badge", "label": "Fallback Play Store badge filename", "visible_if": "{{ false }}" }
  ],
  "presets": [
    { "name": "Feature panel" }
  ]
}
{% endschema %}
