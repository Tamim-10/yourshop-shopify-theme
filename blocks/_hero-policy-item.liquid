{% liquid
  assign block_settings = block.settings
%}
<div class="cp-hero__policy" {{ block.shopify_attributes }}>
  {%- render 'cp-image-with-fallback',
    image: block_settings.icon,
    fallback: block_settings.fallback_image,
    width: 32,
    render_width: 16,
    render_height: 16,
    class: 'cp-hero__policy-icon'
  -%}
  <span>{{ block_settings.label }}</span>
</div>

{% schema %}
{
  "name": "Policy item",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "Fallback asset filename",
      "visible_if": "{{ false }}"
    }
  ],
  "presets": [
    {
      "name": "Policy item"
    }
  ]
}
{% endschema %}
