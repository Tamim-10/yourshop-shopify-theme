{% liquid
  assign block_settings = block.settings
%}
<div class="cp-mission__slide" ref="slides[]" {{ block.shopify_attributes }}>
  {%- if block_settings.image != blank -%}
    {{ block_settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800' }}
  {%- endif -%}
  <p><span>{{ block_settings.lead_text }} – </span>{{ block_settings.text }}</p>
</div>

{% schema %}
{
  "name": "Mission slide",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "lead_text", "label": "Bold lead-in", "default": "Durable" },
    { "type": "text", "id": "text", "label": "Description", "default": "Slide description." }
  ],
  "presets": [
    { "name": "Mission slide" }
  ]
}
{% endschema %}
