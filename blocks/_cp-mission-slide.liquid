{% liquid
  assign block_settings = block.settings
%}
<div class="cp-mission__slide" ref="slides[]" {{ block.shopify_attributes }}>
  {%- render 'cp-image-with-fallback',
    image: block_settings.image,
    fallback: block_settings.fallback_image,
    width: 800
  -%}
  <p><span>{{ block_settings.lead_text }} – </span>{{ block_settings.text }}</p>
</div>

{% schema %}
{
  "name": "Mission slide",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "lead_text", "label": "Bold lead-in", "default": "Durable" },
    { "type": "text", "id": "text", "label": "Description", "default": "Slide description." },
    { "type": "text", "id": "fallback_image", "label": "Fallback asset filename", "visible_if": "{{ false }}" }
  ],
  "presets": [
    { "name": "Mission slide" }
  ]
}
{% endschema %}
