{% liquid
  assign block_settings = block.settings
%}
<div class="cp-adventure__slide" ref="slides[]" {{ block.shopify_attributes }}>
  {%- render 'cp-image-with-fallback',
    image: block_settings.image,
    fallback: block_settings.fallback_image,
    width: 900
  -%}
  <p>{{ block_settings.caption }}</p>
</div>

{% schema %}
{
  "name": "Adventure slide",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Adventure" },
    { "type": "text", "id": "fallback_image", "label": "Fallback asset filename", "visible_if": "{{ false }}" }
  ],
  "presets": [
    { "name": "Adventure slide" }
  ]
}
{% endschema %}
