{% liquid
  assign block_settings = block.settings
  assign inline_style = 'width:' | append: block_settings.width | append: 'px'
%}
<div class="cp-seen__logo" {{ block.shopify_attributes }}>
  {%- render 'cp-image-with-fallback',
    image: block_settings.image,
    fallback: block_settings.fallback_image,
    class: 'cp-seen__logo-image',
    style: inline_style
  -%}
</div>

{% schema %}
{
  "name": "Logo item",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Logo"
    },
    {
      "type": "number",
      "id": "width",
      "label": "Width (px)",
      "default": 150
    },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "Fallback asset filename",
      "visible_if": "{{ false }}"
    }
  ],
  "presets": [
    { "name": "Logo item" }
  ]
}
{% endschema %}
