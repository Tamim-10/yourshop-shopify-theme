{%- comment -%}
  Full-width image band that opens a topic: eyebrow, heading, text and Stat blocks.
{%- endcomment -%}
<div class="cw-band{% if block.settings.flip %} is-flipx{% endif %}" {{ block.shopify_attributes }}>
  {% render 'cw-img', image: block.settings.image, alt: block.settings.image_alt, style: block.settings.image_style, sizes: '(min-width: 1280px) 1000px, (min-width: 900px) 75vw, 100vw' %}
  <div class="cw-band-in">
    {%- if block.settings.eyebrow != blank %}<div class="cw-eyebrow">{{ block.settings.eyebrow }}</div>{% endif %}
    <h2>{{ block.settings.heading }}</h2>
    {%- if block.settings.text != blank %}<p>{% render 'cw-rich', html: block.settings.text %}</p>{% endif %}
    <div class="cw-stats">{% content_for 'blocks' %}</div>
  </div>
</div>

{% schema %}
{
  "name": "Image band",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "image_style",
      "label": "Image CSS (advanced)",
      "info": "Optional, e.g. object-position: 30% center"
    },
    {
      "type": "checkbox",
      "id": "flip",
      "label": "Mirror image",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Feature"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "_wiki-stat"
    }
  ],
  "presets": [
    {
      "name": "Image band"
    }
  ]
}
{% endschema %}
