{%- comment -%}
  Closing "Still need a hand?" panel with contact cards.
{%- endcomment -%}
{%- liquid
  assign anchor = block.settings.anchor | handleize | default: block.id
-%}
<section
  class="pg-help"
  id="{{ anchor }}"
  data-pg-chapter
  data-title="{{ block.settings.title | escape }}"
  aria-labelledby="{{ anchor }}-heading"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <h2 id="{{ anchor }}-heading">{{ block.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if block.settings.text != blank -%}
    <p class="pg-help-text">{{ block.settings.text }}</p>
  {%- endif -%}

  <div class="pg-help-grid">
    {% content_for 'blocks' %}
  </div>

  {%- if block.settings.signoff != blank -%}
    <p class="pg-help-sign">{{ block.settings.signoff | escape }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Help panel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Contents label",
      "default": "Get help",
      "info": "Shown in the contents list."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "help"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still need a hand?"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "signoff",
      "label": "Closing line"
    }
  ],
  "blocks": [
    { "type": "_guide-help-card" }
  ],
  "presets": [
    {
      "name": "Help panel"
    }
  ]
}
{% endschema %}
