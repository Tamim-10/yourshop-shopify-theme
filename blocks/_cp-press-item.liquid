{% liquid
  assign block_settings = block.settings
%}
<div class="cp-press__item" {{ block.shopify_attributes }}>
  {%- render 'cp-image-with-fallback',
    image: block_settings.image,
    fallback: block_settings.fallback_image,
    width: 800,
    class: 'cp-press__image'
  -%}
  <p class="cp-press__quote">&ldquo;{{ block_settings.quote }}&rdquo;</p>
  {%- render 'cp-image-with-fallback',
    image: block_settings.logo,
    fallback: block_settings.fallback_logo,
    width: 440,
    render_width: 200
  -%}
  <span class="cp-press__author">{{ block_settings.author }}</span>
  {%- if block_settings.link != blank -%}
    <a href="{{ block_settings.link }}" class="cp-press__link">Read article &gt;</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Press item",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "textarea", "id": "quote", "label": "Quote" },
    { "type": "image_picker", "id": "logo", "label": "Publication logo" },
    { "type": "text", "id": "author", "label": "Author name", "default": "Author name" },
    { "type": "url", "id": "link", "label": "Article link" },
    { "type": "text", "id": "fallback_image", "label": "Fallback image asset filename", "visible_if": "{{ false }}" },
    { "type": "text", "id": "fallback_logo", "label": "Fallback logo asset filename", "visible_if": "{{ false }}" }
  ],
  "presets": [
    { "name": "Press item" }
  ]
}
{% endschema %}
