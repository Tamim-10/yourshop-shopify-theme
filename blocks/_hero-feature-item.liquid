{% liquid
  assign block_settings = block.settings
%}
<div class="cp-hero__feature" {{ block.shopify_attributes }}>
  {%- if block_settings.icon != blank -%}
    {{ block_settings.icon | image_url: width: 48 | image_tag: loading: 'lazy', width: 24, height: 24, class: 'cp-hero__feature-icon' }}
  {%- endif -%}
  <span class="cp-hero__feature-label">{{ block_settings.label }}</span>
</div>

{% schema %}
{
  "name": "Feature item",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Feature"
    }
  ],
  "presets": [
    {
      "name": "Feature item"
    }
  ]
}
{% endschema %}
