{%- comment -%}
  Call-to-action strip with up to two buttons.
{%- endcomment -%}
<div class="cw-next" {{ block.shopify_attributes }}>
  <div>
    <b class="cw-next-t">{{ block.settings.title }}</b>
    <i class="cw-next-d">{{ block.settings.text }}</i>
  </div>
  <div class="cw-next-btns">
    {%- if block.settings.button_label != blank %}<a class="cw-btn" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>{% endif %}
    {%- if block.settings.button2_label != blank %}<a class="cw-btn is-ghost" href="{{ block.settings.button2_link | default: '#' }}">{{ block.settings.button2_label }}</a>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Call to action",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Title"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Second button link"
    }
  ],
  "presets": [
    {
      "name": "Call to action"
    }
  ]
}
{% endschema %}
