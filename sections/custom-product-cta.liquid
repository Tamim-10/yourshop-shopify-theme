<section
  class="cp-cta"
  style="
    --cp-cta-bg-desktop: url({{ section.settings.background_image | image_url: width: 2000 }});
    --cp-cta-bg-mobile: url({{ section.settings.background_image_mobile | image_url: width: 1200 }});
  "
>
  <div class="cp-cta__inner">
    <div class="cp-cta__content">
      <h4>{{ section.settings.heading }}</h4>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link }}" class="cp-cta__button">{{ section.settings.button_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cp-cta {
    font-family: 'Sohne', sans-serif;
    background-image: var(--cp-cta-bg-desktop);
    background-repeat: no-repeat;
    background-size: 100%;
    height: 856px;
    position: relative;
  }

  .cp-cta__inner {
    max-width: 1320px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
  }

  .cp-cta__content {
    position: absolute;
    left: 24px;
    bottom: 95px;
    max-width: 480px;
  }

  .cp-cta__content h4 {
    font-weight: 500;
    font-size: 64px;
    line-height: 100%;
    color: #fff;
    margin: 0;
  }

  .cp-cta__content p {
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    font-size: 18px;
    line-height: 150%;
    color: rgba(240, 235, 224, 1);
    margin: 16px 0 24px;
  }

  .cp-cta__button {
    display: inline-block;
    background-color: rgba(13, 109, 238, 1);
    padding: 12px 24px;
    border-radius: 200px;
    font-weight: 500;
    font-size: 16px;
    text-align: center;
    color: rgba(253, 249, 242, 1);
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .cp-cta {
      background-image: var(--cp-cta-bg-mobile, var(--cp-cta-bg-desktop));
      background-size: 100%;
      height: 680px;
    }

    .cp-cta__content {
      left: 4%;
      bottom: 30px;
    }

    .cp-cta__content h4 {
      font-size: 42px;
    }

    .cp-cta__content p {
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom product CTA banner",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image (desktop)" },
    { "type": "image_picker", "id": "background_image_mobile", "label": "Background image (mobile)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Life's good when you're connected" },
    { "type": "text", "id": "text", "label": "Text", "default": "COSMO keeps you close to what matters most" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Add to cart" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Custom product CTA banner", "category": "Product" }
  ]
}
{% endschema %}
