{%- comment -%}
  JrTrack Wiki — "Still have a question?" panel with Help card blocks. Appears in the sidebar navigation.
{%- endcomment -%}
{{ 'cosmo-wiki.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cosmo-wiki.js' | asset_url }}" defer="defer"></script>
<div class="cw cw-part">
  <div class="cw-shell">
    <div class="cw-side-slot" aria-hidden="true"></div>
    <div class="cw-main cw-main--part">
      <section class="cw-help" id="{{ section.settings.anchor_id | handleize }}" data-cw-title="{{ section.settings.nav_title | escape }}">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
        <div class="cw-help-grid">
          {% content_for 'blocks' %}
        </div>
        {%- if section.settings.signoff != blank %}<p class="cw-help-sign">{{ section.settings.signoff }}</p>{% endif %}
      </section>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wiki help",
  "tag": "div",
  "class": "cw-help-section",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "help",
      "info": "Lowercase letters, numbers and hyphens. Used in links such as #halogps, so keep it unique on the page."
    },
    {
      "type": "text",
      "id": "nav_title",
      "label": "Navigation title",
      "default": "Get help"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still have a question?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "signoff",
      "label": "Sign-off",
      "default": "Reach for More."
    }
  ],
  "blocks": [
    {
      "type": "_wiki-help-card"
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Wiki help"
    }
  ]
}
{% endschema %}
