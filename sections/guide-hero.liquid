{%- comment -%}
  Guide hero: eyebrow, heading, intro, search box and a grid of quick links.
  Pair it with the "Guide content" section underneath.
{%- endcomment -%}
{{ 'product-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-guide.js' | asset_url }}" type="module"></script>
<noscript><style>.pg-search { display: none; }</style></noscript>

<div
  class="pg pg-herowrap"
  style="{%- render 'guide-colors', settings: section.settings -%}"
>
  <header class="pg-hero">
    <div class="pg-hero-in">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pg-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="pg-hero-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <div class="pg-hero-search">
          {%- render 'guide-search',
            uid: section.id,
            label: section.settings.search_label,
            placeholder: section.settings.search_placeholder,
            empty_title: section.settings.search_empty_title,
            empty_text: section.settings.search_empty_text,
            results_label: section.settings.search_results_label,
            shortcut: false
          -%}
        </div>
      {%- endif -%}
    </div>
  </header>

  <section class="pg-quick" aria-labelledby="pg-quick-{{ section.id }}">
    <div class="pg-quick-in">
      {%- if section.settings.quick_heading != blank -%}
        <h2 class="pg-quick-h" id="pg-quick-{{ section.id }}">{{ section.settings.quick_heading | escape }}</h2>
      {%- endif -%}
      <div class="pg-quick-grid">
        {% content_for 'blocks' %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Guide hero",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "User Guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product guide"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Intro text",
      "default": "Everything you need to set up the product and run it day to day."
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search box",
      "default": true
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search label (screen readers)",
      "default": "Search the guide"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder",
      "default": "Search the guide"
    },
    {
      "type": "text",
      "id": "search_empty_title",
      "label": "No results heading",
      "default": "No matches for",
      "info": "The search term is added after this text."
    },
    {
      "type": "text",
      "id": "search_empty_text",
      "label": "No results text",
      "default": "Try a different word."
    },
    {
      "type": "text",
      "id": "search_results_label",
      "label": "Results count word (screen readers)",
      "default": "results",
      "info": "Announced after the number of matches, e.g. \"3 results\"."
    },
    {
      "type": "header",
      "content": "Quick links"
    },
    {
      "type": "text",
      "id": "quick_heading",
      "label": "Heading",
      "default": "Most people come here for"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Text",
      "default": "#655b50"
    },
    {
      "type": "color",
      "id": "muted",
      "label": "Secondary text",
      "default": "#7a7166"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#0068ff"
    },
    {
      "type": "color",
      "id": "highlight",
      "label": "Highlight",
      "default": "#c7800c"
    },
    {
      "type": "color",
      "id": "dark",
      "label": "Dark",
      "default": "#052b5d"
    }
  ],
  "blocks": [
    {
      "type": "_guide-quick-link"
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Guide hero"
    }
  ]
}
{% endschema %}
