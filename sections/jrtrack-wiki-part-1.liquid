<div class="cw-fcard-b"><b class="cw-fcard-t">{{ section.settings.cw_feat_19 }}</b><i class="cw-fcard-d">{{ section.settings.cw_feat_20 }}</i></div>
</a>
<a class="cw-fcard" href="#care">
<div class="cw-fcard-img"><img src="{{ 'cosmo-wiki-life-6.jpg' | file_url }}" alt="" loading="lazy"></div>
<div class="cw-fcard-b"><b class="cw-fcard-t">{{ section.settings.cw_feat_21 }}</b><i class="cw-fcard-d">{{ section.settings.cw_feat_22 }}</i></div>
</a>
<a class="cw-fcard" href="#grows">
<div class="cw-fcard-img"><img src="{{ 'cosmo-wiki-life-16.jpg' | file_url }}" alt="" loading="lazy"></div>
<div class="cw-fcard-b"><b class="cw-fcard-t">{{ section.settings.cw_feat_23 }}</b><i class="cw-fcard-d">{{ section.settings.cw_feat_24 }}</i></div>
</a>
<a class="cw-fcard" href="#compare">
<div class="cw-fcard-img"><img src="{{ 'cosmo-wiki-life-14.jpg' | file_url }}" alt="" loading="lazy"></div>
<div class="cw-fcard-b"><b class="cw-fcard-t">{{ section.settings.cw_feat_25 }}</b><i class="cw-fcard-d">{{ section.settings.cw_feat_26 }}</i></div>
</a>
</div>
</section>
<div class="cw-mobnav">
<select aria-label="Jump to feature" data-cw-mobnav></select>
</div>

