<div class="cw-fcard-b"><b class="cw-fcard-t">{{ section.settings.cw_feat_11 }}</b><i class="cw-fcard-d">{{ section.settings.cw_feat_12 }}</i></div>
</a>
<a class="cw-fcard" href="#appstation">
<div class="cw-fcard-img"><img src="{{ 'cosmo-wiki-life-9.jpg' | file_url }}" alt="" loading="lazy"></div>
<div class="cw-fcard-b"><b class="cw-fcard-t">{{ section.settings.cw_feat_13 }}</b><i class="cw-fcard-d">{{ section.settings.cw_feat_14 }}</i></div>
</a>
<a class="cw-fcard" href="#app">
