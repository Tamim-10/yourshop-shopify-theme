{%- comment -%} jrtrack-wiki-part-1 - part of jrtrack-wiki. Use inside the template-jrtrack-wiki wrapper (it holds the styles, scripts and layout containers). {%- endcomment -%}
<div class="cw-top">
<div class="cw-top-in">
<div class="cw-brand">{{ section.settings.page_01 }}</div>
<div class="cw-top-spacer"></div>
<div class="cw-search" data-cw-search>
<div class="cw-search-field">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
<input type="text" placeholder="Search features and answers" aria-label="Search" autocomplete="off" spellcheck="false">
<kbd class="cw-kbd">/</kbd>
</div>
<div class="cw-results" role="listbox"></div>
</div>
<a class="cw-top-cta" href="/products/jrtrack-pro">{{ section.settings.page_02 }}</a>
</div>
</div>
<header class="cw-hero">
<div class="cw-hero-in">
<div>
<div class="cw-eyebrow">{{ section.settings.cw_hero_01 }}</div>
<h1>{{ section.settings.cw_hero_02 }}</h1>
<p class="cw-hero-sub">{{ section.settings.cw_hero_03 }}</p>
<div class="cw-hero-search">
<div class="cw-search" data-cw-search>
<div class="cw-search-field">
<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
<input type="text" placeholder="Try &ldquo;SOS&rdquo;, &ldquo;accuracy&rdquo;, &ldquo;school&rdquo;, &ldquo;water&rdquo;&hellip;" aria-label="Search" autocomplete="off" spellcheck="false">
</div>
<div class="cw-results" role="listbox"></div>
</div>
</div>
<div class="cw-hero-meta">
<span class="cw-meta">{{ section.settings.cw_hero_04 }}</span>
<span class="cw-meta">{{ section.settings.cw_hero_05 }}</span>
<span class="cw-meta">{{ section.settings.cw_hero_06 }}</span>
</div>
</div>
<figure class="cw-hero-img">
<img src="{{ 'cosmo-wiki-hero-crop.jpg' | file_url }}" alt="Three kids lying in the grass at sunset, one wearing a JrTrack" width="2040" height="1133" fetchpriority="high">
<figcaption>{{ section.settings.cw_hero_07 }}</figcaption>
</figure>
</div>
</header>
<section class="cw-feat">
<div class="cw-feat-h"><h2>{{ section.settings.cw_feat_01 }}</h2><span class="cw-feat-sub">{{ section.settings.cw_feat_02 }}</span></div>
<div class="cw-feat-grid">
<a class="cw-fcard" href="#halogps">
<div class="cw-fcard-img"><img src="{{ 'cosmo-wiki-life-8.jpg' | file_url }}" alt="" loading="lazy"></div>
<div class="cw-fcard-b"><b class="cw-fcard-t">{{ section.settings.cw_feat_03 }}</b><i class="cw-fcard-d">{{ section.settings.cw_feat_04 }}</i></div>
</a>
<a class="cw-fcard" href="#safecore">
<div class="cw-fcard-img"><img src="{{ 'cosmo-wiki-life-7.jpg' | file_url }}" alt="" loading="lazy"></div>
<div class="cw-fcard-b"><b class="cw-fcard-t">{{ section.settings.cw_feat_05 }}</b><i class="cw-fcard-d">{{ section.settings.cw_feat_06 }}</i></div>
</a>
<a class="cw-fcard" href="#texting">
