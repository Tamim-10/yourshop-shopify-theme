<div class="cw-fcard-b"><b class="cw-fcard-t">{{ section.settings.cw_feat_17 }}</b><i class="cw-fcard-d">{{ section.settings.cw_feat_18 }}</i></div>
</a>
<a class="cw-fcard" href="#design">
