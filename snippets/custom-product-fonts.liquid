{% comment %}
  Renders the Sohne @font-face declarations used by the custom-product-* sections.
  Render this once, before the first custom-product-* section on the page.
{% endcomment %}
<style>
  @font-face {
    font-family: 'Sohne';
    src:
      {{ 'Sohne-Buch.woff2' | asset_url }} format('woff2'),
      {{ 'Sohne-Buch.woff' | asset_url }} format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Sohne';
    src:
      {{ 'Sohne-Leicht.woff2' | asset_url }} format('woff2'),
      {{ 'Sohne-Leicht.woff' | asset_url }} format('woff');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Sohne';
    src:
      {{ 'Sohne-Kraftig.woff' | asset_url }} format('woff');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Sohne';
    src:
      {{ 'Sohne-Halbfett.woff2' | asset_url }} format('woff2'),
      {{ 'Sohne-Halbfett.woff' | asset_url }} format('woff');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Sohne';
    src:
      {{ 'Sohne-Dreiviertelfett.woff2' | asset_url }} format('woff2'),
      {{ 'Sohne-Dreiviertelfett.woff' | asset_url }} format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
