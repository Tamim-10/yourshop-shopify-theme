{%- comment -%}
  Inline SVG icons for the wiki. Param: name (search, search-lg, is-tip, is-note, is-info, totop).
{%- endcomment -%}
{%- case name -%}
  {%- when 'search' -%}<svg fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-width="2.2" viewBox="0 0 24 24" width="16"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
  {%- when 'search-lg' -%}<svg fill="none" height="19" stroke="currentColor" stroke-linecap="round" stroke-width="2.2" viewBox="0 0 24 24" width="19"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
  {%- when 'is-tip' -%}<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18h6M10 21.5h4"></path><path d="M12 2.5a6.5 6.5 0 00-3.7 11.8c.5.4.7.9.7 1.5V16h6v-.2c0-.6.2-1.1.7-1.5A6.5 6.5 0 0012 2.5z"></path></svg>
  {%- when 'totop' -%}<svg fill="none" height="17" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewBox="0 0 24 24" width="17"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
  {%- else -%}<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v5.5M12 7.6v.1"></path></svg>
{%- endcase -%}
