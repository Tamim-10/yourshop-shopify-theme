    "testimonials": {
      "type": "custom-product-testimonials",
      "blocks": {
        "t1": { "type": "_cp-testimonial-item", "settings": { "quote": "I love having something where my boys can get exposure to and ownership of technology as a powerful tool for connection, without incurring a lot of the dangers that are out there today.", "name": "Erin E.", "location": "Texas", "fallback_image": "Ellipse-6.png" } },
        "t2": { "type": "_cp-testimonial-item", "settings": { "quote": "It's given us a lot of freedom and confidence knowing they can go play and we can all stay in touch if I need them or they need me.", "name": "Marcus T.", "location": "Ohio", "fallback_image": "Ellipse-6.png" } },
        "t3": { "type": "_cp-testimonial-item", "settings": { "quote": "The parent app makes it so easy to see exactly where my kids are without hovering. It's peace of mind without the guilt.", "name": "Priya K.", "location": "California", "fallback_image": "Ellipse-6.png" } }
      },
      "block_order": ["t1", "t2", "t3"]
    },
