          "block_order": ["f1", "f2", "f3", "f4", "f5", "f6"]
        },
        "hero-policy-list": {
          "type": "_hero-policy-list",
          "static": true,
          "blocks": {
            "p1": { "type": "_hero-policy-item", "settings": { "label": "Free Shipping", "fallback_image": "tick.svg" } },
            "p2": { "type": "_hero-policy-item", "settings": { "label": "Hassle-Free Returns", "fallback_image": "tick.svg" } },
            "p3": { "type": "_hero-policy-item", "settings": { "label": "30 Day Money Back Guarantee", "fallback_image": "tick.svg" } }
          },
          "block_order": ["p1", "p2", "p3"]
        },
        "hero-add-to-cart": {
          "type": "add-to-cart",
          "static": true,
          "settings": {
            "style_class": "button-custom",
            "custom_button_background": "rgba(13, 109, 238, 1)",
            "custom_button_text": "#ffffff",
            "custom_button_border": "rgba(13, 109, 238, 1)"
          }
        }
      }
    },
    "faq": {
      "type": "custom-product-faq",
      "blocks": {
        "faq_accordion": {
          "type": "accordion",
          "settings": { "icon": "plus", "dividers": true },
          "blocks": {
            "row-1": {
              "type": "_accordion-row",
              "settings": { "open_by_default": true, "heading": "What's in the Box" },
              "blocks": {
                "text-1": {
                  "type": "text",
                  "settings": { "text": "<p>JrTrack 5 watch, magnetic charging cable, quick start guide.</p>", "width": "100%" }
                }
              },
              "block_order": ["text-1"]
            },
            "row-2": {
              "type": "_accordion-row",
              "settings": { "heading": "Full feature list" },
              "blocks": {
                "text-1": {
                  "type": "text",
                  "settings": {
                    "text": "<ul><li>True SMS texting, picture, video, and voice messaging</li><li>Approved contacts only</li><li>GPS tracking &amp; safezones</li><li>No social media or internet browsing</li><li>Mission control parent app</li><li>Kid-safe music</li><li>Enhanced parental controls &amp; optional apps</li><li>Reminders &amp; alarms</li><li>SOS Mode &amp; 911 calling (optional)</li><li>2 MP front-facing camera</li><li>IP68 water resistant to one meter</li><li>Pedometer &amp; activity goals</li><li>US, Canada, &amp; Mexico calling coverage</li><li>School mode (distraction-free!)</li><li>Reliable nationwide calling with FlexSIM technology</li></ul>",
                    "width": "100%"
                  }
                }
              },
              "block_order": ["text-1"]
            },
            "row-3": {
              "type": "_accordion-row",
              "settings": { "heading": "Data plans & coverage" },
              "blocks": {
                "text-1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>JrTrack 5 uses FlexSIM technology for reliable nationwide coverage across the US, Canada, and Mexico. Data plans are managed monthly through the parent app.</p>",
                    "width": "100%"
                  }
                }
              },
              "block_order": ["text-1"]
            },
            "row-4": {
              "type": "_accordion-row",
              "settings": { "heading": "COSMO guarantee" },
              "blocks": {
                "text-1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We think JrTrack stands out as the best buy for families: best safety features with our proprietary SafeCORE technology, best connection with real family-safe texting, and best value with premium features at a price that makes sense for families.</p>",
                    "width": "100%"
                  }
                }
              },
              "block_order": ["text-1"]
            }
          },
          "block_order": ["row-1", "row-2", "row-3", "row-4"]
        }
      },
      "block_order": ["faq_accordion"]
    },
    "seen_in": {
      "type": "custom-product-seen-in",
      "blocks": {
        "l1": { "type": "_cp-logo-item", "settings": { "width": 159, "fallback_image": "safewise-3x.png" } },
        "l2": { "type": "_cp-logo-item", "settings": { "width": 293, "fallback_image": "new-york-times-3x.png" } },
        "l3": { "type": "_cp-logo-item", "settings": { "width": 120, "fallback_image": "new-york-live-3x.png" } },
        "l4": { "type": "_cp-logo-item", "settings": { "width": 215, "fallback_image": "Parents-3x.png" } },
        "l5": { "type": "_cp-logo-item", "settings": { "width": 58, "fallback_image": "pc-mag-3x.png" } },
        "l6": { "type": "_cp-logo-item", "settings": { "width": 170, "fallback_image": "Fatherly-Logo.png" } }
      },
      "block_order": ["l1", "l2", "l3", "l4", "l5", "l6"]
    },
    "how_it_works": {
      "type": "custom-product-how-it-works",
      "blocks": {
        "panel-1": {
          "type": "_cp-how-it-works-panel",
          "settings": {
            "heading": "Connection made for kids",
            "text": "<p>JrTrack is the award-winning first device for kids that unlocks the best of childhood with connection and safety. It's all the essentials with none of the worry.</p>",
            "fallback_image": "large-watch.png"
          },
          "blocks": {
            "i1": { "type": "_cp-panel-icon", "settings": { "label": "Calling", "fallback_image": "iocn-11.svg" } },
            "i2": { "type": "_cp-panel-icon", "settings": { "label": "Messaging", "fallback_image": "icon-12.svg" } },
            "i3": { "type": "_cp-panel-icon", "settings": { "label": "Safety", "fallback_image": "icon-13.svg" } },
            "i4": { "type": "_cp-panel-icon", "settings": { "label": "GPS", "fallback_image": "icon-14.svg" } },
            "i5": { "type": "_cp-panel-icon", "settings": { "label": "Music", "fallback_image": "icon-15.svg" } },
            "i6": { "type": "_cp-panel-icon", "settings": { "label": "Camera", "fallback_image": "icon-16.svg" } }
          },
          "block_order": ["i1", "i2", "i3", "i4", "i5", "i6"]
        },
        "panel-2": {
          "type": "_cp-how-it-works-panel",
          "settings": {
            "heading": "Peace of mind for parents",
            "text": "<p>COSMO gives parents all the tools for confident connection. Get the latest and manage everything in one simple place with the parent app.</p>",
            "reverse_layout": true,
            "show_store_badges": true,
            "fallback_image": "large-mobile-new.png",
            "fallback_app_store_badge": "Store-download-button.png",
            "fallback_play_store_badge": "Store-download-button-1.png"
          },
          "blocks": {
            "i1": { "type": "_cp-panel-icon", "settings": { "label": "Real-time tracking", "fallback_image": "icon-56.svg" } },
            "i2": { "type": "_cp-panel-icon", "settings": { "label": "Parental controls", "fallback_image": "icon-12.svg" } },
            "i3": { "type": "_cp-panel-icon", "settings": { "label": "Approved contacts", "fallback_image": "icon-13.svg" } },
            "i4": { "type": "_cp-panel-icon", "settings": { "label": "Insights dashboard", "fallback_image": "icon-16.svg" } }
          },
          "block_order": ["i1", "i2", "i3", "i4"]
        }
      },
      "block_order": ["panel-1", "panel-2"]
    },
    "tracking": {
      "type": "custom-product-tracking",
      "settings": {
        "image_fallback": "watch-large-2.png"
      },
      "blocks": {
        "t1": { "type": "_cp-tracking-item", "settings": { "lead_text": "Real-time active tracking", "text": "The only kids watch with real-time, up-to-the-second tracking, built for the speed of parenting.", "fallback_image": "icon-91.svg" } },
        "t2": { "type": "_cp-tracking-item", "settings": { "lead_text": "Unmatched accuracy", "text": "All-new HaloGPS puts the power of 115 GNSS satellite signals at your fingertips for amazing location accuracy.", "fallback_image": "icon-92.svg" } },
        "t3": { "type": "_cp-tracking-item", "settings": { "lead_text": "Advanced performance", "text": "Powered by a dedicated, state-of-the-art chip, HaloGPS offers dynamic position accuracy with longer battery life.", "fallback_image": "icon-93.svg" } },
        "t4": { "type": "_cp-tracking-item", "settings": { "lead_text": "Faster location lock", "text": "Find their real location in seconds, thanks to advanced assisted GPS (aGPS) technology with up to 92% faster location lock.", "fallback_image": "icon-94.svg" } }
      },
      "block_order": ["t1", "t2", "t3", "t4"]
    },
    "families": {
      "type": "custom-product-families",
      "settings": {
        "image_fallback": "Frame-48754.png"
      },
      "blocks": {
        "f1": { "type": "_cp-family-feature", "settings": { "heading": "Messaging made easy", "text": "<p>Share the moments that matter most. Text, picture, video, and voice messaging is easier than ever with all-new voice-to-text and predictive text.</p>" } },
        "f2": { "type": "_cp-family-feature", "settings": { "heading": "Focus Mode", "text": "<p>Connection without distraction. All-new Focus Mode gives parents flexible controls to set how and when your child's device is locked.</p>" } },
        "f3": { "type": "_cp-family-feature", "settings": { "heading": "Apps & flexible parental controls", "text": "<p>Choose from a growing library of kid-safe apps. Plus, set daily time limits on any app. JrTrack is ready to safely grow with your child!</p>" } },
        "f4": { "type": "_cp-family-feature", "settings": { "heading": "Parent Insights Dashboard", "text": "<p>Our all-new Parent Insights Dashboard keeps you in the know. See activity, app usage, full message history, and more in one simple spot.</p>", "highlight": true } },
        "f5": { "type": "_cp-family-feature", "settings": { "heading": "HaloGPS + Active Tracking", "text": "<p>Feel the confidence with JrTrack 5. It's the only kids watch with real-time, up-to-the-second tracking, with all-new HaloGPS technology.</p>" } }
      },
      "block_order": ["f1", "f2", "f3", "f4", "f5"]
    },
    "mission_slider": {
      "type": "custom-product-mission-slider",
      "blocks": {
        "m1": { "type": "_cp-mission-slide", "settings": { "lead_text": "Durable", "text": "JrTrack 5 is ready for what kids throw at it. It's certified IP68 and water resistant up to 1.5 meters (5 feet).", "fallback_image": "fff.jpg" } },
        "m2": { "type": "_cp-mission-slide", "settings": { "lead_text": "All day battery", "text": "No matter how long practice is, JrTrack 5 has you covered with all-day battery.", "fallback_image": "fff.jpg" } },
        "m3": { "type": "_cp-mission-slide", "settings": { "lead_text": "Safety", "text": "JrTrack 5 offers the best safety in the industry through required parent-approved contacts, extensive calling range, and industry-leading real time location tracking.", "fallback_image": "fff.jpg" } },
        "m4": { "type": "_cp-mission-slide", "settings": { "lead_text": "Easy charging", "text": "No need to worry about social media -- your kids don't have access to it. You'll also have the ability to turn on focus modes during activities like school or homework.", "fallback_image": "fff.jpg" } }
      },
      "block_order": ["m1", "m2", "m3", "m4"]
    },
