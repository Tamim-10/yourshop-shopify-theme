          "type": "_hero-feature-list",
          "static": true,
          "blocks": {
            "f1": { "type": "_hero-feature-item", "settings": { "label": "Precision HaloGPS", "fallback_image": "Pin.svg" } },
            "f2": { "type": "_hero-feature-item", "settings": { "label": "Real-time Active Tracking", "fallback_image": "Tracking-1.svg" } },
            "f3": { "type": "_hero-feature-item", "settings": { "label": "Parent-controlled talk, text & data", "fallback_image": "Message.svg" } },
            "f4": { "type": "_hero-feature-item", "settings": { "label": "Distraction-free Focus Mode", "fallback_image": "Reviews.svg" } },
            "f5": { "type": "_hero-feature-item", "settings": { "label": "Flexible parental controls", "fallback_image": "Parental-Controls.svg" } },
            "f6": { "type": "_hero-feature-item", "settings": { "label": "Optional apps & music", "fallback_image": "Music.svg" } }
