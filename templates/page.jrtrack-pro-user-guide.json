            "article-action-blocked": {
              "type": "_guide-article",
              "settings": {
                "title": "When the Action button does nothing",
                "anchor": "action-blocked"
              },
              "blocks": {
                "text-14": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ul><li>In apps installed from App Station</li><li>During first-time setup</li><li>While a software update is checking or installing</li><li>In Storage management</li><li>During Water ejection</li><li>During a fully or partially restricted Routine, so it can’t be used to get around school restrictions</li></ul>",
                    "show_seal": false
                  }
                },
                "note-4": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "note",
                    "title": "",
                    "text": "Quick Access also never opens on top of a call screen or while recording video or a voice note. In those cases the Action button either does the screen’s action or nothing."
                  }
                }
              },
              "block_order": [
                "text-14",
                "note-4"
              ]
            }
          },
          "block_order": [
            "article-power-button",
            "article-action-button",
            "article-action-settings",
            "article-contextual-actions",
            "article-action-blocked"
          ]
        },
        "chapter-app": {
          "type": "_guide-chapter",
          "settings": {
            "title": "The Cosmo app",
            "anchor": "app",
            "intro": "Your control center. Available on iOS and Android."
          },
          "blocks": {
            "article-app-navigation": {
              "type": "_guide-article",
              "settings": {
                "title": "Finding your way around",
                "anchor": "app-navigation",
                "image_asset": "jrtrack-app-controls-455x960.webp",
                "image_alt": "Controls tab in the Cosmo app showing a list of children, My account, My parent portal, Push notifications and Support",
                "caption": "The Controls tab",
                "figure_position": "side",
                "figure_width": "default",
                "device": "app"
              },
              "blocks": {
                "text-15": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ul><li><strong>Home</strong> is the map with your child’s location. Tap your child to see battery, last location, and buttons to Call, Text, Track and Find.</li><li><strong>Activity</strong> is a feed of what has happened: Routine arrivals and departures, check-ins, step goals, low battery, SOS alerts and more.</li><li><strong>Controls</strong> holds your child profiles, My account, the Parent Portal, push notification settings and support.</li><li><strong>Child profile</strong>, reached by tapping a child in Controls, is where the device information, Routines, Contacts, Guardians, Alarms, App Station, Fitness, Location tracking, Preset messages, Safety features, and call and location history live.</li></ul>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-15"
              ]
            },
            "article-child-hub": {
              "type": "_guide-article",
              "settings": {
                "title": "Each child’s profile",
                "anchor": "child-hub",
                "image_asset": "jrtrack-app-childprofile-455x914.webp",
                "image_alt": "Child profile screen in the Cosmo app showing a paired JrTrack Pro, a Home Routine and Contacts",
                "caption": "One screen per child, scrolled for the rest",
                "figure_position": "side",
                "figure_width": "default",
                "device": "app"
              },
              "blocks": {
                "text-16": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Tap a child in Controls to open their profile. This is the screen you will use most. It holds their watch, their Routines, everyone allowed to contact them, and every feature you can turn on or off.</p><p>Scroll down the same screen for Alarms, App Station, Fitness, Location tracking, Preset messages and Safety features, then call and location history at the bottom.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-16"
              ]
            },
            "article-activity-feed": {
              "type": "_guide-article",
              "settings": {
                "title": "The Activity feed",
                "anchor": "activity-feed"
              },
              "blocks": {
                "text-17": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Activity lists device and account events in order, so you can catch up without opening anything else.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-17"
              ]
            },
            "article-push-notifications": {
              "type": "_guide-article",
              "settings": {
                "title": "Push notifications",
                "anchor": "push-notifications"
              },
              "blocks": {
                "text-18": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Go to <strong>Controls › Push notifications</strong>. All categories are on by default: Connection requests, Device usage, Routines, Step goals, and SOS and emergencies.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-18"
              ]
            }
          },
          "block_order": [
            "article-app-navigation",
            "article-child-hub",
            "article-activity-feed",
            "article-push-notifications"
          ]
        },
        "chapter-contacts": {
          "type": "_guide-chapter",
          "settings": {
            "title": "Contacts & buddies",
            "anchor": "contacts",
            "intro": "Only people you approve can reach the watch. Unknown numbers never get through."
          },
          "blocks": {
            "article-contact-types": {
              "type": "_guide-article",
              "settings": {
                "title": "The three contact types",
                "anchor": "contact-types"
              },
              "blocks": {
                "kv-list-2": {
                  "type": "_guide-kv",
                  "settings": {},
                  "blocks": {
                    "kv-3": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Contact",
                        "value": "Can call and text the watch. Works as soon as you add them."
                      }
                    },
                    "kv-4": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Guardian",
                        "value": "Can call, text and have access to a child’s location and settings through the Cosmo app. They can be invited from the Guardians page."
                      }
                    },
                    "kv-5": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Buddy",
                        "value": "Another child’s Cosmo watch. The two kids add each other over Bluetooth, then both parents approve."
                      }
                    }
                  },
                  "block_order": [
                    "kv-3",
                    "kv-4",
                    "kv-5"
                  ]
                },
                "text-19": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>In the app, you appear with a star, guardians with a shield and buddies with the Cosmo “C”.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "kv-list-2",
                "text-19"
              ]
            },
            "article-guardians": {
              "type": "_guide-article",
              "settings": {
                "title": "Invite a guardian",
                "anchor": "guardians"
              },
              "blocks": {
                "text-20": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Guardians get their own login and access to the app. Good for a second parent, a grandparent, or a nanny.</p><ol><li>Go to your child’s profile and tap <strong>Guardians</strong>.</li><li>Tap <strong>+</strong>, enter their name and email, and pick which children you want them to be a guardian for.</li><li>If they already use the Cosmo app, the invite appears in their app. If not, they download the app, create an account, and then review the invite.</li></ol><p>Once accepted, a guardian is added as a contact on the watch and can:</p><ul><li>See your child on the map, marked with a shield icon</li><li>Receive activity updates and push notifications</li><li>Edit the child profile, location settings and safety settings</li><li>Manage location tracking, contacts, Routines and preset messages</li><li>View communication history and fitness history</li></ul>",
                    "show_seal": false
                  }
                },
                "note-5": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "note",
                    "title": "Some things stay with the primary parent.",
                    "text": "Guardians cannot delete the child profile, add or remove a watch, or change billing information."
                  }
                }
              },
              "block_order": [
                "text-20",
                "note-5"
              ]
            },
            "article-add-contact": {
              "type": "_guide-article",
              "settings": {
                "title": "Add a contact",
                "anchor": "add-contact",
                "image_asset": "jrtrack-watch-contacts-560x921.webp",
                "image_alt": "Contacts list on the watch showing Mom and Dad starred, Lara, a 911 entry and Call history",
                "caption": "Approved contacts as they appear on the watch",
                "figure_position": "side",
                "figure_width": "wide",
                "device": "watch"
              },
              "blocks": {
                "text-21": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>Go to your child’s profile and tap <strong>Contacts</strong>.</li><li>Tap <strong>+</strong>.</li><li>Enter their name, country code and phone number.</li><li>Select which children this contact can reach.</li><li>Tap the blue check to save.</li><li>Optional: tap <strong>Send SMS</strong> if you want to text them a ready-made message saying they can now call or text your child.</li></ol><p>The contact appears on the watch straight away.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-21"
              ]
            },
            "article-add-buddy": {
              "type": "_guide-article",
              "settings": {
                "title": "Add a buddy",
                "anchor": "add-buddy",
                "image_asset": "jrtrack-watch-buddy-600x730.webp",
                "image_alt": "Add a Buddy on the watch searching for nearby watches, with Cam ready to add and Lara needing a software update",
                "caption": "Both kids search at the same time",
                "figure_position": "side",
                "figure_width": "wide",
                "device": "watch"
              },
              "blocks": {
                "text-22": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>Both watches need to be near each other with Bluetooth on.</li><li>Each child opens the <strong>Add a Buddy</strong> app and finds the other watch.</li><li>Both children tap the checkmark to confirm.</li><li>A blue dot appears on Controls, the child and Contacts in each parent’s app.</li><li>Approve or reject the request in Contacts or in Activity.</li><li>Once both parents approve, the kids can call and text each other.</li></ol><p>Buddies work between JrTrack 5 SE and JrTrack Pro watches.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-22"
              ]
            },
            "article-remove-contact": {
              "type": "_guide-article",
              "settings": {
                "title": "Remove a contact",
                "anchor": "remove-contact"
              },
              "blocks": {
                "text-23": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>Go to your child’s <strong>Contacts</strong>.</li><li>Tap the contact, then <strong>Remove Contact</strong>.</li></ol><p>Removing a buddy removes them from both watches. To remove a guardian, use the Guardians page.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-23"
              ]
            }
          },
          "block_order": [
            "article-contact-types",
            "article-guardians",
            "article-add-contact",
            "article-add-buddy",
            "article-remove-contact"
          ]
        },
        "chapter-location": {
          "type": "_guide-chapter",
          "settings": {
            "title": "Location & GPS",
            "anchor": "location"
          },
          "blocks": {
            "article-see-location": {
              "type": "_guide-article",
              "settings": {
                "title": "See where your child is",
                "anchor": "see-location"
              },
              "blocks": {
                "text-24": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Your child’s latest location shows on the Home map. When the map is open, any location older than 3 minutes refreshes automatically. A circle around the pin means the location is less precise than 100 ft. Tap your child to see their address, battery and quick actions to call, message or track.</p>",
                    "show_seal": false
                  }
                },
                "note-6": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "tip",
                    "title": "Turn on Wi-Fi for better indoor accuracy.",
                    "text": "GPS struggles inside buildings. Wi-Fi can provide a much better location at school or at home."
                  }
                }
              },
              "block_order": [
                "text-24",
                "note-6"
              ]
            },
            "article-battery": {
              "type": "_guide-article",
              "settings": {
                "title": "How often location updates",
                "anchor": "battery",
                "image_asset": "jrtrack-app-location-settings-494x1000.webp",
                "image_alt": "Location tracking settings showing the update frequency slider from 5 to 60 minutes and a scheduled window of 7:00am to 7:00pm",
                "caption": "Frequency and schedule, both on one screen",
                "figure_position": "side",
                "figure_width": "default",
                "device": "app"
              },
              "blocks": {
                "text-25": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Location updates automatically. The default is <strong>every 30 minutes, between 7am and 7pm</strong> in the watch’s timezone.</p><ol><li>Open your child’s profile and tap <strong>Location tracking</strong>.</li><li>Pick 5, 10, 15, 30, 45 or 60 minutes, or turn updates off.</li><li>Choose a time window, or turn the schedule off to update around the clock.</li><li>Tap the blue check to save.</li></ol>",
                    "show_seal": false
                  }
                },
                "note-7": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "warn",
                    "title": "More frequent updates use more battery.",
                    "text": "The JrTrack Pro is built to last up to 72 hours on standby. If the battery drains faster than you’d like, lengthen the interval or limit updates to daytime."
                  }
                }
              },
              "block_order": [
                "text-25",
                "note-7"
              ]
            },
            "article-live-tracking": {
              "type": "_guide-article",
              "settings": {
                "title": "Live Tracking",
                "anchor": "live-tracking",
                "image_asset": "jrtrack-app-live-tracking-455x914.webp",
                "image_alt": "Live Tracking in the Cosmo app, with a child's pin pulsing green on the map and a Tracking label",
                "caption": "The green pulse means tracking is live",
                "figure_position": "side",
                "figure_width": "default",
                "device": "app"
              },
              "blocks": {
                "text-26": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>On the Home map, tap your child, then tap <strong>Track</strong>.</li><li>Location updates every second for up to 5 minutes. A pulsing green pin and the <strong>Tracking</strong> label mean it’s connected.</li><li>Tap <strong>X</strong> to stop early.</li></ol><p>Live Tracking points are saved to Location history every 10 seconds.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-26"
              ]
            },
            "article-location-history": {
              "type": "_guide-article",
              "settings": {
                "title": "Location history",
                "anchor": "location-history"
              },
              "blocks": {
                "text-27": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>Open your child’s profile and tap <strong>Location history</strong>.</li><li>Pick a date from the calendar.</li><li>Tap a pin to see the time, address, and whether GPS or Wi-Fi was used.</li></ol>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-27"
              ]
            },
            "article-check-in": {
              "type": "_guide-article",
              "settings": {
                "title": "Check in",
                "anchor": "check-in"
              },
              "blocks": {
                "text-28": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Your child can send you their location from <strong>Quick Settings › Check-in</strong>. You get a push notification and an activity, and a green check on the map for three minutes.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-28"
              ]
            },
            "article-find-device": {
              "type": "_guide-article",
              "settings": {
                "title": "Find my device",
                "anchor": "find-device"
              },
              "blocks": {
                "text-29": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Lost the watch somewhere nearby? Tap your child on the map (or open their profile) and tap <strong>Find</strong>. The watch plays a sound for 5 seconds, even when muted or in a Routine. Your child can stop it early.</p><p>Find won’t play during a call, a recording, an alarm, or SOS.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-29"
              ]
            }
          },
          "block_order": [
            "article-see-location",
            "article-battery",
            "article-live-tracking",
            "article-location-history",
            "article-check-in",
            "article-find-device"
          ]
        },
        "chapter-routines": {
          "type": "_guide-chapter",
          "settings": {
            "title": "Routines & School-Fi",
            "anchor": "routines"
          },
          "blocks": {
            "article-what-are-routines": {
              "type": "_guide-article",
              "settings": {
                "title": "What Routines are",
                "anchor": "what-are-routines"
              },
              "blocks": {
                "text-30": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Routines change what the watch can do automatically, based on where your child is, the time, or both.</p>",
                    "show_seal": false
                  }
                },
                "kv-list-3": {
                  "type": "_guide-kv",
                  "settings": {},
                  "blocks": {
                    "kv-6": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Location only",
                        "value": "Alerts when your child arrives or leaves."
                      }
                    },
                    "kv-7": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Schedule only",
                        "value": "Restricts the watch at set times, like bedtime."
                      }
                    },
                    "kv-8": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Location and schedule",
                        "value": "Restricts the watch during set times, with arrival and departure alerts during that time. Use Real-time detection to automatically check your child’s location more frequently around the start and end times. Intelligent Mode can be used to restrict the watch only after your child has arrived at their location."
                      }
                    }
                  },
                  "block_order": [
                    "kv-6",
                    "kv-7",
                    "kv-8"
                  ]
                }
              },
              "block_order": [
                "text-30",
                "kv-list-3"
              ]
            },
            "article-school-routine": {
              "type": "_guide-article",
              "settings": {
                "title": "Set up a School Routine",
                "anchor": "school-routine"
              },
              "blocks": {
                "text-31": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>In your child’s profile, tap <strong>Add Routine</strong> and choose the school icon.</li><li>Search for the school. If it’s not listed, add it by name and address.</li><li>Set the school boundary on the map.</li><li>Set the days and hours.</li><li>Pick a restriction level.</li><li>Tap <strong>Save</strong>.</li></ol>",
                    "show_seal": false
                  }
                },
                "note-8": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "info",
                    "title": "School Routines turn on Intelligent Mode and Real-time detection by default.",
                    "text": "Restrictions start only once the school day has started <strong>and</strong> your child is at school, so a sick day at home stays unrestricted. If plans change, turn the Routine off for the day from its Activity entry."
                  }
                }
              },
              "block_order": [
                "text-31",
                "note-8"
              ]
            },
            "article-restriction-levels": {
              "type": "_guide-article",
              "settings": {
                "title": "What each restriction level does",
                "anchor": "restriction-levels"
              },
              "blocks": {
                "levels-1": {
                  "type": "_guide-levels",
                  "settings": {},
                  "blocks": {
                    "level-1": {
                      "type": "_guide-level",
                      "settings": {
                        "title": "Fully restricted",
                        "tone": "red",
                        "allowed": "SOS",
                        "blocked": "Calls and messages\nApps, camera, games\nAction button",
                        "allowed_label": "Works:",
                        "blocked_label": "Does not work:"
                      }
                    },
                    "level-2": {
                      "type": "_guide-level",
                      "settings": {
                        "title": "Partially restricted",
                        "tone": "amber",
                        "allowed": "SOS\nCalls and messages with parents and guardians\n911, if you enabled it",
                        "blocked": "Calling other contacts\nApps, camera, games",
                        "allowed_label": "Works:",
                        "blocked_label": "Does not work:"
                      }
                    },
                    "level-3": {
                      "type": "_guide-level",
                      "settings": {
                        "title": "Unrestricted",
                        "tone": "green",
                        "allowed": "Everything",
                        "blocked": "",
                        "allowed_label": "Works:",
                        "blocked_label": "Does not work:"
                      }
                    }
                  },
                  "block_order": [
                    "level-1",
                    "level-2",
                    "level-3"
                  ]
                },
                "text-32": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>When the Routine ends, the watch returns to normal on its own. Children can’t turn a Routine off. Only the primary parent and guardians can.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "levels-1",
                "text-32"
              ]
            },
            "article-other-routines": {
              "type": "_guide-article",
              "settings": {
                "title": "Other Routines",
                "anchor": "other-routines"
              },
              "blocks": {
                "text-33": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>In your child’s profile, tap <strong>Routines › Add Routine</strong>.</li><li>Name it, choose an icon, and add a location, a schedule or both.</li><li>For a location, choose whether you want arrival and departure alerts.</li><li>For a schedule, choose the restriction level.</li><li>Tap <strong>Save</strong>.</li></ol>",
                    "show_seal": false
                  }
                },
                "note-9": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "tip",
                    "title": "Arrival alerts are only as fast as your update interval.",
                    "text": "They fire off the back of location updates, so a shorter interval means quicker notifications, at the cost of battery."
                  }
                }
              },
              "block_order": [
                "text-33",
                "note-9"
              ]
            }
          },
          "block_order": [
            "article-what-are-routines",
            "article-school-routine",
            "article-restriction-levels",
            "article-other-routines"
          ]
        },
        "chapter-messages": {
          "type": "_guide-chapter",
          "settings": {
            "title": "Calls & messages",
            "anchor": "messages"
          },
          "blocks": {
            "article-calling": {
              "type": "_guide-article",
              "settings": {
                "title": "Calling",
                "anchor": "calling"
              },
              "blocks": {
                "text-34": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Your child can only call, and be called by, approved contacts and guardians.</p><ul><li><strong>Incoming call:</strong> tap green to answer or red to decline, or press the Action button to answer.</li><li><strong>Make a call:</strong> open the Phone app, pick a contact, and tap to call. If Calling is set as Quick Access, press the Action button from the home screen.</li><li><strong>End a call:</strong> tap the red button or press the Action button.</li></ul>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-34"
              ]
            },
            "article-messaging": {
              "type": "_guide-article",
              "settings": {
                "title": "Messaging",
                "anchor": "messaging",
                "image_asset": "jrtrack-watch-messages-560x1251.webp",
                "image_alt": "A conversation on the watch with photo, camera and voice memo buttons, a Send text field and preset replies",
                "caption": "Type, snap, record, or tap a preset",
                "figure_position": "side",
                "figure_width": "wide",
                "device": "watch"
              },
              "blocks": {
                "text-35": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>The JrTrack Pro has a real phone number and sends real SMS. Your child can text, and send photos, videos and voice memos to approved contacts, who reply from their normal messaging app.</p><ul><li><strong>Open Messages:</strong> press the Action button from the home screen (Messages is the default Quick Access app), or tap the Messages icon.</li><li><strong>Pick a contact,</strong> then choose keyboard, photo or video, or voice note.</li><li><strong>Action button:</strong> sends text messages, takes the photo or video, and starts or stops voice memos.</li><li><strong>Voice to text:</strong> tap the microphone to dictate.</li><li><strong>Preset messages</strong> are one-tap replies. Edit them in the Cosmo app under your child’s profile › Preset messages.</li></ul>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-35"
              ]
            },
            "article-review-messages": {
              "type": "_guide-article",
              "settings": {
                "title": "Review your child’s messages",
                "anchor": "review-messages"
              },
              "blocks": {
                "text-36": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Full message history can be found on the Message history page in your child’s profile and in the Parent Portal (<strong>Controls › My parent portal</strong>, or <a href=\"https://parent.cosmotogether.com\">parent.cosmotogether.com</a>).</p>",
                    "show_seal": false
                  }
                },
                "note-10": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "note",
                    "title": "Your child is not notified",
                    "text": "when you read their messages."
                  }
                }
              },
              "block_order": [
                "text-36",
                "note-10"
              ]
            }
          },
          "block_order": [
            "article-calling",
            "article-messaging",
            "article-review-messages"
          ]
        },
        "chapter-apps": {
          "type": "_guide-chapter",
          "settings": {
            "title": "App Station",
            "anchor": "apps",
            "intro": "You install the apps. Your child can’t add anything themselves."
          },
          "blocks": {
            "article-install-apps": {
              "type": "_guide-article",
              "settings": {
                "title": "Install an app",
                "anchor": "install-apps",
                "image_asset": "jrtrack-app-station-494x1000.webp",
                "image_alt": "App Station in the Cosmo app showing available and installed apps including iHeart Radio, Spotify, The Week Junior and 2048 with a 30 minute limit",
                "caption": "The app library, with time limits shown inline",
                "figure_position": "side",
                "figure_width": "default",
                "device": "app"
              },
              "blocks": {
                "text-37": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>Make sure the watch is on Wi-Fi.</li><li>In your child’s profile, tap <strong>App Station</strong>.</li><li>Browse and tap <strong>Download</strong>.</li></ol>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-37"
              ]
            },
            "article-time-limits": {
              "type": "_guide-article",
              "settings": {
                "title": "Set a time limit",
                "anchor": "time-limits"
              },
              "blocks": {
                "text-38": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>In App Station, tap an installed app.</li><li>Tap <strong>Set Time Limit</strong> and choose a daily allowance.</li></ol><p>Once the allowance runs out, the app locks until the next calendar day.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-38"
              ]
            },
            "article-remove-app": {
              "type": "_guide-article",
              "settings": {
                "title": "Remove an app",
                "anchor": "remove-app"
              },
              "blocks": {
                "text-39": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>Find the installed app in App Station.</li><li>Tap <strong>Uninstall</strong>. It is removed from the watch remotely.</li></ol>",
                    "show_seal": false
                  }
                },
                "note-11": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "note",
                    "title": "Unpairing the watch does not remove apps.",
                    "text": "They stay on the watch until you uninstall them through App Station."
                  }
                }
              },
              "block_order": [
                "text-39",
                "note-11"
              ]
            },
            "article-music": {
              "type": "_guide-article",
              "settings": {
                "title": "Music",
                "anchor": "music"
              },
              "blocks": {
                "text-40": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Kids can stream music apps installed from App Station over Wi-Fi. Save songs or playlists for offline playback. You can pair Bluetooth headphones or a speaker for audio.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-40"
              ]
            }
          },
          "block_order": [
            "article-install-apps",
            "article-time-limits",
            "article-remove-app",
            "article-music"
          ]
        },
        "chapter-alarms": {
          "type": "_guide-chapter",
          "settings": {
            "title": "Alarms & fitness",
            "anchor": "alarms"
          },
          "blocks": {
            "article-alarms-app": {
              "type": "_guide-article",
              "settings": {
                "title": "Set an alarm from the app",
                "anchor": "alarms-app"
              },
              "blocks": {
                "text-41": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>Open your child’s profile and tap <strong>Alarms</strong>.</li><li>Tap <strong>+</strong>, set the time and name, and pick repeat days (leave them blank for a one-time alarm).</li><li>Tap <strong>Save</strong>.</li></ol><p>Alarms your child sets on the watch also show in the app, but cannot be changed there.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-41"
              ]
            },
            "article-alarms-watch": {
              "type": "_guide-article",
              "settings": {
                "title": "Set an alarm from the watch",
                "anchor": "alarms-watch",
                "image_asset": "jrtrack-watch-alarms-600x730.webp",
                "image_alt": "Alarms app on the watch with a New alarm button, a starred Wake up alarm at 7:00am every day, and a Homework alarm at 7:00pm",
                "caption": "The star marks an alarm set from the app",
                "figure_position": "side",
                "figure_width": "wide",
                "device": "watch"
              },
              "blocks": {
                "text-42": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Open <strong>Alarms</strong>, tap <strong>New Alarm</strong>, set the time and repeat, then tap the checkmark.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-42"
              ]
            },
            "article-steps": {
              "type": "_guide-article",
              "settings": {
                "title": "Steps and goals",
                "anchor": "steps",
                "image_asset": "jrtrack-app-steps-494x1000.webp",
                "image_alt": "Fitness screen in the Cosmo app showing a weekly step chart, daily average, current streak and daily step goal",
                "caption": "Daily average, streak and goal in one place",
                "figure_position": "side",
                "figure_width": "default",
                "device": "app"
              },
              "blocks": {
                "text-43": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<ol><li>Open your child’s profile and tap <strong>Fitness</strong>.</li><li>See today’s steps, their current streak, and daily, 7-day and 31-day step history.</li><li>Change the daily goal (5,000 steps by default) and their height, weight and gender.</li></ol>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-43"
              ]
            }
          },
          "block_order": [
            "article-alarms-app",
            "article-alarms-watch",
            "article-steps"
          ]
        },
        "chapter-sos": {
          "type": "_guide-chapter",
          "settings": {
            "title": "SOS & emergency",
            "anchor": "sos"
          },
          "blocks": {
            "article-sos-mode": {
              "type": "_guide-article",
              "settings": {
                "title": "SOS mode",
                "anchor": "sos-mode",
                "image_asset": "jrtrack-watch-sos-700x852.webp",
                "image_alt": "SOS countdown on the watch showing 12 seconds left, a red cancel button and Activating SOS",
                "caption": "The countdown, with a chance to cancel",
                "figure_position": "side",
                "figure_width": "wide",
                "device": "watch"
              },
              "blocks": {
                "note-12": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "warn",
                    "title": "SOS does not call 911.",
                    "text": "It alerts you and your guardians. If you want your child to be able to reach emergency services, turn on 911 calling separately."
                  }
                },
                "text-44": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p><strong>How your child starts it</strong></p><ol><li>Press and hold the Power button for 5 seconds.</li><li>A silent 15-second countdown runs, so an accidental press can be canceled.</li><li>Once it confirms, the alert goes out and Live Tracking begins.</li></ol><p><strong>What you receive</strong></p><ul><li>A push notification (if SOS and emergencies notifications are on) and an Activity</li><li>Location tracking, updating every second, shown on the map with an SOS status</li><li>If you call the watch while SOS is active, it connects silently, so you can hear what is happening without your child needing to answer the call</li></ul><p><strong>Turning it off</strong></p><p>On the Home map, tap the <strong>X</strong> to dismiss the SOS and confirm.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "note-12",
                "text-44"
              ]
            },
            "article-emergency-911": {
              "type": "_guide-article",
              "settings": {
                "title": "911 calling",
                "anchor": "emergency-911",
                "image_asset": "jrtrack-app-safety-455x914.webp",
                "image_alt": "Safety features screen in the Cosmo app with toggles for Show emergency calling, Wireless emergency alerts and Voice transcription",
                "caption": "Safety features, set from your phone",
                "figure_position": "side",
                "figure_width": "default",
                "device": "app"
              },
              "blocks": {
                "text-45": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Emergency calling is <strong>off by default</strong>. When it’s on, your child can call emergency services from the watch, behind a confirmation step so it can’t be triggered by accident.</p><p><strong>To turn it on</strong></p><ol><li>Open your child’s profile and tap <strong>Safety features</strong>.</li><li>Enable <strong>Show emergency calling</strong>.</li></ol><p>The same screen controls Wireless Emergency Alerts and Voice transcription. Your child can’t change these on the watch.</p>",
                    "show_seal": false
                  }
                },
                "note-13": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "note",
                    "title": "Not available in a fully restricted Routine.",
                    "text": "If the watch is in full lockdown, 911 calling is switched off along with everything else. Use partially restricted if you want emergency calling to stay available during school."
                  }
                }
              },
              "block_order": [
                "text-45",
                "note-13"
              ]
            }
          },
          "block_order": [
            "article-sos-mode",
            "article-emergency-911"
          ]
        },
        "chapter-watch": {
          "type": "_guide-chapter",
          "settings": {
            "title": "The watch itself",
            "anchor": "watch"
          },
          "blocks": {
            "article-watch-navigation": {
              "type": "_guide-article",
              "settings": {
                "title": "Getting around",
                "anchor": "watch-navigation"
              },
              "blocks": {
                "text-46": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Swipe left and right on the home screen to move between app pages. Press the Power button to go back, double press it to go home, or swipe in from the left edge. Apps you install from App Station are added to these pages.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-46"
              ]
            },
            "article-camera": {
              "type": "_guide-article",
              "settings": {
                "title": "Camera and photos",
                "anchor": "camera",
                "image_asset": "jrtrack-watch-gallery-700x852.webp",
                "image_alt": "Gallery app on the watch listing All, Photos and Videos folders",
                "caption": "Everything they shoot lands in Gallery",
                "figure_position": "side",
                "figure_width": "wide",
                "device": "watch"
              },
              "blocks": {
                "text-47": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Open the Camera and tap the shutter or press the Action button to take a photo. Switch between photo and video on the main camera screen.</p><p>Everything lands in <strong>Gallery</strong>, sorted into Photos and Videos.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-47"
              ]
            },
            "article-voice-notes": {
              "type": "_guide-article",
              "settings": {
                "title": "Voice Notes",
                "anchor": "voice-notes"
              },
              "blocks": {
                "text-48": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>The Voice Notes app records notes up to 5 minutes long. Press the Action button to start and stop recording and to play a note back.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-48"
              ]
            },
            "article-watch-face": {
              "type": "_guide-article",
              "settings": {
                "title": "Customizing the JrTrack Pro",
                "anchor": "watch-face",
                "image_asset": "jrtrack-watch-face-picker-700x852.webp",
                "image_alt": "Watch face picker showing a clock over a colorful wallpaper, with clock style, color and wallpaper options below",
                "image_2_asset": "jrtrack-watch-face-confirm-700x852.webp",
                "image_2_alt": "Watch face preview with cancel and confirm buttons and a choice of two clock layouts",
                "caption": "Pick a clock style, color and wallpaper, then confirm",
                "figure_position": "below",
                "device": "app"
              },
              "blocks": {
                "text-49": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Open the customization app (the watch with a paintbrush icon) to pick a clock style and color, a pre-loaded wallpaper, or one of the photos on the watch.</p><p>Ringtones are in Device Settings.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-49"
              ]
            },
            "article-quick-settings": {
              "type": "_guide-article",
              "settings": {
                "title": "Quick Settings",
                "anchor": "quick-settings",
                "image_asset": "jrtrack-watch-quick-settings-520x1258.webp",
                "image_alt": "Quick Settings panel on the watch with Wi-Fi and Bluetooth on, brightness and volume sliders, Check-in, mute, flashlight, water ejection, settings, power off and restart",
                "caption": "Hold the Power button for 1 second",
                "figure_position": "side",
                "figure_width": "wide",
                "device": "watch"
              },
              "blocks": {
                "text-50": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Hold the Power button for 1 second to open Quick Settings:</p><ul><li>Wi-Fi and Bluetooth</li><li>Brightness and volume</li><li>Check-in (send your location to parents)</li><li>Silent mode and flashlight</li><li>Water ejection</li><li>Full Settings</li><li>Power off and restart</li></ul><p>A <strong>green icon</strong> means on. A <strong>red mute icon</strong> means the watch is muted.</p>",
                    "show_seal": false
                  }
                },
                "note-14": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "note",
                    "title": "",
                    "text": "Quick Settings is unavailable during calls and software updates."
                  }
                }
              },
              "block_order": [
                "text-50",
                "note-14"
              ]
            },
            "article-water-ejection": {
              "type": "_guide-article",
              "settings": {
                "title": "Water ejection",
                "anchor": "water-ejection",
                "image_asset": "jrtrack-watch-water-700x852.webp",
                "image_alt": "Water ejection running on the watch, a water drop icon with the words Getting rid of the water",
                "caption": "Clears the speaker after a swim or a splash",
                "figure_position": "side",
                "figure_width": "wide",
                "device": "watch"
              },
              "blocks": {
                "text-51": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Water ejection plays a tone to clear water from the speaker after the watch gets wet. Start it from Quick Settings. Buttons are paused while it runs.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-51"
              ]
            },
            "article-device-settings": {
              "type": "_guide-article",
              "settings": {
                "title": "Device settings",
                "anchor": "device-settings",
                "image_asset": "jrtrack-watch-settings-520x1468.webp",
                "image_alt": "Settings menu on the watch listing Updates, Bluetooth, Wi-Fi, Device settings, Pair device, About, Support and More",
                "caption": "The Settings menu on the watch",
                "figure_position": "side",
                "figure_width": "wide",
                "device": "watch"
              },
              "blocks": {
                "text-52": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Open <strong>Device Settings</strong> from the Settings menu on the watch for:</p><ul><li>Action Button</li><li>Display</li><li>Sound and vibration</li><li>Time</li><li>Call options and text options</li><li>Gestures</li><li>Storage</li><li>Location</li></ul><p>Emergency calling, Wireless Emergency Alerts and voice transcription are set by the parent in the Cosmo app. See <a href=\"#emergency-911\">911 calling</a>.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-52"
              ]
            },
            "article-updates": {
              "type": "_guide-article",
              "settings": {
                "title": "Software updates",
                "anchor": "updates",
                "image_asset": "jrtrack-watch-update-found-700x1011.webp",
                "image_alt": "Update found screen on the watch showing a new version with Update now and Skip update buttons",
                "image_2_asset": "jrtrack-watch-update-current-700x852.webp",
                "image_2_alt": "Watch screen confirming Your watch is up to date",
                "caption": "An update waiting, and a watch that’s up to date",
                "figure_position": "below",
                "device": "app"
              },
              "blocks": {
                "text-53": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Open <strong>Settings</strong> and tap <strong>Updates</strong>. A green update icon means an update is waiting. Keep the watch charged and on Wi-Fi while it installs.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-53"
              ]
            }
          },
          "block_order": [
            "article-watch-navigation",
            "article-camera",
            "article-voice-notes",
            "article-watch-face",
            "article-quick-settings",
            "article-water-ejection",
            "article-device-settings",
            "article-updates"
          ]
        },
        "chapter-account": {
          "type": "_guide-chapter",
          "settings": {
            "title": "Plan & billing",
            "anchor": "account"
          },
          "blocks": {
            "article-parent-portal": {
              "type": "_guide-article",
              "settings": {
                "title": "The Parent Portal",
                "anchor": "parent-portal"
              },
              "blocks": {
                "text-54": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>For billing and plan management, go to <a href=\"https://parent.cosmotogether.com\">parent.cosmotogether.com</a>, or tap <strong>My parent portal</strong> under Controls.</p><p>Only the subscriber who purchased the membership plan can change payment information or cancel. Parents and guardians can see app usage, call, message and step history, and manage apps.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-54"
              ]
            },
            "article-billing": {
              "type": "_guide-article",
              "settings": {
                "title": "View your plan",
                "anchor": "billing"
              },
              "blocks": {
                "text-55": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Log in to the Parent Portal and click <strong>Plans</strong> to see active plans, payment details, next bill date and the watch’s IMEI. Billing changes and cancellations are handled there. Need help? Email <a href=\"mailto:support@cosmotogether.com\">support@cosmotogether.com</a>.</p>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-55"
              ]
            },
            "article-cosmo-care": {
              "type": "_guide-article",
              "settings": {
                "title": "Cosmo Care",
                "anchor": "cosmo-care"
              },
              "blocks": {
                "kv-list-4": {
                  "type": "_guide-kv",
                  "settings": {},
                  "blocks": {
                    "kv-9": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Cosmo Care Basic",
                        "value": "$2.99/mo. Covers all damage, including water."
                      }
                    },
                    "kv-10": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Cosmo Care Plus",
                        "value": "$5.99/mo. Covers damage, loss and theft."
                      }
                    }
                  },
                  "block_order": [
                    "kv-9",
                    "kv-10"
                  ]
                },
                "text-56": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Upgrade eligibility varies by membership and Cosmo Care plan. Review the current Cosmo Care terms for complete coverage and upgrade details.</p>",
                    "show_seal": false
                  }
                },
                "note-15": {
                  "type": "_guide-note",
                  "settings": {
                    "style": "warn",
                    "title": "Cosmo Care has to be added when you buy your membership.",
                    "text": ""
                  }
                }
              },
              "block_order": [
                "kv-list-4",
                "text-56",
                "note-15"
              ]
            },
            "article-guarantee": {
              "type": "_guide-article",
              "settings": {
                "title": "30-day money back guarantee",
                "anchor": "guarantee"
              },
              "blocks": {
                "seal-1": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>Cosmo offers a 30-day money-back guarantee. Eligibility, nonrefundable fees, device-return requirements and other conditions may apply. Contact <a href=\"mailto:support@cosmotogether.com\">support@cosmotogether.com</a> within 30 days and review the current <a href=\"https://cosmotogether.com/pages/returns-cancellations\">Returns &amp; Cancellations policy</a>.</p>",
                    "show_seal": true
                  }
                }
              },
              "block_order": [
                "seal-1"
              ]
            }
          },
          "block_order": [
            "article-parent-portal",
            "article-billing",
            "article-cosmo-care",
            "article-guarantee"
          ]
        },
        "chapter-specs": {
          "type": "_guide-chapter",
          "settings": {
            "title": "Technical specifications",
            "anchor": "specs"
          },
          "blocks": {
            "article-tech-specs": {
              "type": "_guide-article",
              "settings": {
                "title": "JrTrack Pro specs",
                "anchor": "tech-specs"
              },
              "blocks": {
                "kv-list-5": {
                  "type": "_guide-kv",
                  "settings": {},
                  "blocks": {
                    "kv-11": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Display",
                        "value": "1.78 inch OLED, 368 x 488, curved edges"
                      }
                    },
                    "kv-12": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Dimensions",
                        "value": "52 x 43 x 12.8 mm"
                      }
                    },
                    "kv-13": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Battery",
                        "value": "720 mAh, up to 72 hours standby"
                      }
                    },
                    "kv-14": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Camera",
                        "value": "5MP, photo and video"
                      }
                    },
                    "kv-15": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Cellular",
                        "value": "4G LTE, eSIM"
                      }
                    },
                    "kv-16": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "LTE bands",
                        "value": "1, 2, 3, 4, 5, 7, 8, 12, 13, 17, 20, 28, 66"
                      }
                    },
                    "kv-17": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Wi-Fi",
                        "value": "2.4 GHz"
                      }
                    },
                    "kv-18": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Bluetooth",
                        "value": "BLE 4.2"
                      }
                    },
                    "kv-19": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Sensors",
                        "value": "Step counter, compass, altimeter"
                      }
                    },
                    "kv-20": {
                      "type": "_guide-kv-row",
                      "settings": {
                        "label": "Buttons",
