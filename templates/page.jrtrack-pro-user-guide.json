            "article-action-settings": {
              "type": "_guide-article",
              "settings": {
                "title": "Action button settings",
                "anchor": "action-settings",
                "image_asset": "jrtrack-watch-action-600x730.webp",
                "image_alt": "Action screen on the watch with the Context actions toggle switched on and the Shortcut set to Messages",
                "image_2_asset": "jrtrack-watch-action-shortcut-600x730.webp",
                "image_2_alt": "Shortcut picker on the watch with Calling, Camera and Messaging, Messaging selected",
                "caption": "Turn contextual actions on or off, then pick the Quick Access app",
                "figure_position": "below",
                "device": "app"
              },
              "blocks": {
                "text-12": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>On the watch, go to <strong>Settings › Device Settings › Action Button</strong>.</p><ul><li><strong>Contextual action:</strong> on or off. On by default. When on, the button performs that screen’s main action. When it’s off, the Action button always opens the Quick Access app (except on the blocked screens listed below).</li><li><strong>Quick Access:</strong> choose which app the Action button opens: <strong>Messages</strong>, <strong>Calling</strong> or <strong>Camera</strong>.</li></ul>",
                    "show_seal": false
                  }
                }
              },
              "block_order": [
                "text-12"
              ]
            },
            "article-contextual-actions": {
              "type": "_guide-article",
              "settings": {
                "title": "Contextual actions",
                "anchor": "contextual-actions"
              },
              "blocks": {
                "text-13": {
                  "type": "_guide-text",
                  "settings": {
                    "content": "<p>With the contextual action setting on, the Action button does the obvious thing on each screen. On screens without a specific action, it opens the Quick Access app.</p>",
                    "show_seal": false
                  }
                },
